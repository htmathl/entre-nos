# ============================================================
# entre-nós — Supabase (compose enxuto) — variáveis de ambiente
#
# COMO USAR:
#   cp .env.example .env
#   Edite o .env com os valores reais (nunca sobe pro git).
#
# Para gerar ANON_KEY e SERVICE_ROLE_KEY:
#   São JWTs HS256 assinados com o JWT_SECRET.
#   Use: https://supabase.com/docs/guides/self-hosting#api-keys
#   Ou gere com: node -e "require('jsonwebtoken').sign({role:'anon',...}, JWT_SECRET)"
# ============================================================

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=troque-por-senha-forte

# --- JWT ---
# >= 32 caracteres, gerado aleatoriamente (ex: openssl rand -base64 32)
JWT_SECRET=troque-por-segredo-aleatorio-de-32-chars
JWT_EXPIRY=3600

# --- meta / studio ---
# >= 32 caracteres (ex: openssl rand -base64 32)
PG_META_CRYPTO_KEY=troque-por-chave-aleatoria-de-32-chars
STUDIO_DEFAULT_ORGANIZATION=entre-nos
STUDIO_DEFAULT_PROJECT=entre-nos

# --- URLs ---
SUPABASE_PUBLIC_URL=http://localhost:54321
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:54321
ADDITIONAL_REDIRECT_URLS=http://localhost:3000

# --- Chaves de API (JWTs HS256 assinados com JWT_SECRET) ---
# Ver instruções acima para gerar
ANON_KEY=gerar-jwt-com-role-anon
SERVICE_ROLE_KEY=gerar-jwt-com-role-service_role

# --- gotrue ---
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true

# --- realtime ---
# >= 64 caracteres (ex: openssl rand -base64 64)
SECRET_KEY_BASE=troque-por-chave-aleatoria-de-64-chars
REALTIME_DB_ENC_KEY=troque-por-chave-enc
