FROM node:22-slim

WORKDIR /app

# 1. Habilita o pnpm oficial do Node via corepack
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 2. Desativa prompts interativos do pnpm em containers
ENV CI=true

# 3. Copia os manifestos de dependências e configuração
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* .npmrc* ./

# 4. Instala as dependências para Linux
RUN pnpm install --frozen-lockfile

# 5. Copia o restante do código
COPY . .

EXPOSE 3001

ENV HOSTNAME="0.0.0.0"
ENV PORT=3001

# 6. Executa o next dev com webpack na porta 3001 (ativa o WATCHPACK_POLLING)
CMD ["pnpm", "exec", "next", "dev", "--webpack", "--hostname", "0.0.0.0", "--port", "3001"]